# Salin jadi .env saat hosting sendiri.
# --- Login & database (Lovable Cloud, sudah terisi di .env hasil ekspor) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- AI utama: Google Gemini (wajib saat hosting sendiri) ---
GEMINI_API_KEY=AIza...
# Opsional: beberapa kunci sekaligus, dipisah koma. Jika satu kunci kena batas
# kuota, server otomatis mencoba kunci berikutnya.
# GEMINI_API_KEYS=AIzaKunciPertama...,AIzaKunciKedua...
GEMINI_MODEL=gemini-flash-latest

# --- Opsional: foto tujuan dari Google Places (aktifkan Places API (New) & penagihan) ---
# GOOGLE_API_KEY=isi_kunci_google_maps_platform

# --- AI cadangan (opsional) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Opsional: simpan itinerary di MySQL sendiri ---
# DATA_SOURCE=mysql
# VITE_AUTH_MODE=local
# LOCAL_AUTH_SECRET=teks_acak_minimal_16_karakter
# DATABASE_URL=mysql://root:PASSWORD@localhost:3306/tripmate
